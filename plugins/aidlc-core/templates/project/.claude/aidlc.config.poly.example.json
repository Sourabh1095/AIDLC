{
  "$schema": "https://raw.githubusercontent.com/bee-logical/AIDLC/main/docs/aidlc.config.schema.json",
  "$comment": "POLYREPO EXAMPLE. Copy the workspace+repos shape into your aidlc.config.json when the workspace holds several git repos. In poly mode the top-level git/stack/ux blocks are ignored — each repo carries its own. This file lives at the WORKSPACE ROOT (the control plane); the product repos are subfolders under workspace.root.",
  "project": {
    "key": "PROJ",
    "name": "Example polyrepo product"
  },
  "workItems": {
    "source": "markdown",
    "jira": { "site": "", "project": "", "statusMap": {} },
    "ado": { "org": "", "project": "", "statusMap": {} }
  },
  "workspace": {
    "layout": "poly",
    "root": "."
  },
  "repos": [
    {
      "name": "backend",
      "path": "backend",
      "role": "REST API service — NestJS + Postgres",
      "host": "github",
      "remote": "origin",
      "defaultBranch": "main",
      "branchPattern": "{type}/{id}-{slug}",
      "stack": { "frontend": null, "backend": "nestjs", "databases": ["postgres"] },
      "labels": ["backend", "api", "server"],
      "default": true
    },
    {
      "name": "frontend",
      "path": "frontend",
      "role": "Customer web app — Next.js",
      "host": "github",
      "remote": "origin",
      "defaultBranch": "main",
      "branchPattern": "{type}/{id}-{slug}",
      "stack": { "frontend": "nextjs", "backend": null, "databases": [] },
      "labels": ["frontend", "web", "ui"],
      "ux": {
        "enabled": true,
        "target": "desktop-web",
        "renderBaseUrl": "http://localhost:3000",
        "uiPaths": ["app/**", "src/app/**", "components/**", "src/components/**", "**/*.tsx", "**/*.css"]
      }
    },
    {
      "name": "website",
      "path": "website",
      "role": "Marketing site — Next.js static",
      "host": "azure-repos",
      "remote": "origin",
      "defaultBranch": "main",
      "branchPattern": "{type}/{id}-{slug}",
      "$comment": "GitFlow example: feature work branches from and integrates into `develop`, never `main`. mergeStrategy/commitStyle/conventionsSource are the project's OWN conventions — `default` would mean AIDLC's defaults are in use and were not detected.",
      "integrationBranch": "develop",
      "longLivedBranches": ["main", "develop", "release/*"],
      "commitStyle": "conventional",
      "mergeStrategy": "squash",
      "conventionsSource": "codebase-scan",
      "stack": { "frontend": "nextjs", "backend": null, "databases": [] },
      "labels": ["website", "marketing", "landing"],
      "ux": {
        "enabled": true,
        "target": "desktop-web",
        "renderBaseUrl": "http://localhost:3001",
        "uiPaths": ["app/**", "src/**", "**/*.tsx", "**/*.css"]
      }
    },
    {
      "name": "mobile",
      "path": "mobile",
      "role": "React Native / Expo app",
      "host": "github",
      "remote": "origin",
      "defaultBranch": "main",
      "branchPattern": "{type}/{id}-{slug}",
      "stack": { "frontend": "react-native", "backend": null, "databases": [] },
      "labels": ["mobile", "app", "ios", "android"]
    }
  ],
  "pipeline": {
    "autonomy": "high",
    "maxFixCycles": 3,
    "architectThreshold": "M",
    "securityReviewPaths": ["**/auth/**", "**/*.env*", "package.json", "**/middleware*"],
    "envFileAccess": "deny",
    "gates": {
      "ambiguousRequirements": "assume-and-log",
      "$comment": "verify = the project's REAL gate, executed IN ORDER by the run skill. Populated by /aidlc:adopt-apply from a scan, or written by hand. Resolution is most-specific-first: package steps, else repo steps, else the top-level steps below. Note the `absent` entries — a gate the project does NOT have is kept on purpose so every run reports it as a coverage hole instead of counting it green.",
      "verify": {
        "maxItemMinutes": 10,
        "steps": [
          { "name": "lint", "status": "present", "cmd": "npm run lint", "required": true, "scope": "repo" },
          { "name": "typecheck", "status": "present", "cmd": "npm run typecheck", "required": true, "scope": "repo" },
          { "name": "test", "status": "present", "cmd": "npm test", "required": true, "scope": "repo" }
        ],
        "repos": {
          "backend": {
            "steps": [
              { "name": "lint", "status": "present", "cmd": "npm run lint", "required": true, "scope": "repo", "providedByHook": "husky" },
              { "name": "typecheck", "status": "present", "cmd": "npm run typecheck", "required": true, "scope": "repo" },
              { "name": "test", "status": "present", "cmd": "npm test", "required": true, "scope": "repo", "timeoutMinutes": 20, "environmentDependent": true, "services": ["postgres"] },
              { "name": "format", "status": "absent", "required": false, "scope": "repo" }
            ]
          },
          "mobile": {
            "steps": [
              { "name": "lint", "status": "present", "cmd": "npm run lint", "required": true, "scope": "repo" },
              { "name": "test", "status": "absent", "required": false, "scope": "repo" }
            ]
          }
        }
      }
    },
    "verification": {
      "mode": "auto",
      "reviewer": "on-demand",
      "qa": "on-demand",
      "security": "per-epic",
      "securityConfirm": true
    }
  },
  "marketplace": {
    "repo": "bee-logical/AIDLC",
    "promotionBranchPrefix": "promote/"
  }
}
